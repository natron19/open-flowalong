<div class="row g-4">
  <%# Left column — brief summary %>
  <div class="col-md-4">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <span class="fw-semibold">Workshop Brief</span>
        <span class="badge bg-secondary"><%= @brief.duration_minutes %> min</span>
      </div>
      <div class="card-body">
        <h5 class="card-title"><%= @brief.topic %></h5>

        <p class="text-muted small mb-1">Audience</p>
        <p class="mb-3"><%= @brief.audience %></p>

        <p class="text-muted small mb-1">Desired Outcome</p>
        <p class="mb-3"><%= @brief.desired_outcome %></p>

        <% if @brief.notes.present? %>
          <p class="text-muted small mb-1">Notes</p>
          <p class="mb-3"><%= @brief.notes %></p>
        <% end %>
      </div>
      <div class="card-footer d-flex gap-2">
        <%= link_to "Edit", edit_workshop_brief_path(@brief), class: "btn btn-sm btn-outline-secondary" %>
        <%= link_to "Delete", @brief,
            data: { turbo_method: :delete, turbo_confirm: "Delete this workshop and its agenda?" },
            class: "btn btn-sm btn-outline-danger" %>
      </div>
    </div>

    <% unless @agenda %>
      <div class="mt-3"
           data-controller="agenda-generator"
           data-action="turbo:submit-start->agenda-generator#submitting">

        <div data-agenda-generator-target="button">
          <%= button_to "Generate Agenda", workshop_brief_agenda_path(@brief),
              method: :post, class: "btn btn-accent w-100",
              data: { action: "click->agenda-generator#generate" } %>
        </div>

        <div data-agenda-generator-target="spinner" class="d-none text-center">
          <div class="d-flex align-items-center justify-content-center gap-2 mb-2">
            <div class="spinner-border spinner-border-sm" role="status"
                 style="color: var(--accent);">
              <span class="visually-hidden">Generating…</span>
            </div>
            <span class="text-muted small">Generating your agenda…</span>
          </div>
          <button type="button" class="btn btn-sm btn-outline-secondary w-100"
                  data-action="click->agenda-generator#cancel">
            Cancel
          </button>
        </div>

        <p class="text-muted small text-center mt-2 mb-0">
          Agenda generation uses AI. Results may vary. Review before facilitating.
        </p>
      </div>
    <% end %>
  </div>

  <%# Right column — agenda preview or placeholder %>
  <div class="col-md-8">
    <% if @agenda_error %>
      <%= render "shared/ai_error", error_type: @agenda_error %>
    <% end %>

    <% if @agenda %>
      <div class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
          <span class="fw-semibold">Agenda Preview</span>
          <%= link_to "View Full Agenda", workshop_brief_agenda_path(@brief), class: "btn btn-sm btn-outline-secondary" %>
        </div>
        <div class="card-body">
          <%# Show the first section only as a preview %>
          <% first_section = @agenda.body.split(/\n---\n/).first %>
          <div class="text-muted" style="white-space: pre-wrap; font-size: 0.9rem;"><%= first_section %></div>
          <p class="text-muted small mt-3 mb-0">
            &hellip; and more sections.
            <%= link_to "View the full agenda", workshop_brief_agenda_path(@brief) %>.
          </p>
        </div>
      </div>
    <% else %>
      <div class="card h-100">
        <div class="card-body d-flex flex-column align-items-center justify-content-center text-center py-5">
          <p class="text-muted mb-0">Your agenda will appear here after generation.</p>
        </div>
      </div>
    <% end %>
  </div>
</div>
